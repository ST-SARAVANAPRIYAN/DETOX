# Telegram Bot Configuration
# Get your token from @BotFather on Telegram: https://t.me/BotFather
# Steps: /newbot -> Choose name -> Choose username -> Copy token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Backend API Configuration
FLASK_HOST=localhost
FLASK_PORT=5000

# Model Configuration
MODEL_PATH=models/toxicity_model

# Instructions:
# 1. Copy this file to .env
# 2. Replace YOUR_BOT_TOKEN_HERE with your actual token from @BotFather
# 3. Never commit .env file to git (it's in .gitignore)
